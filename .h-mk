    v1.18.1 // indirect\n    \tgithub.com/go-git/gcfg v1.5.1-0.20230307220236-3a3c6141e376
    // indirect\n    \tgithub.com/go-git/go-billy/v5 v5.4.1 // indirect\n    \tgithub.com/golang/groupcache
    v0.0.0-20210331224755-41bb18bfe9da // indirect\n    \tgithub.com/imdario/mergo
