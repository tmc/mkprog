    v1.10.0 // indirect\n    \tgithub.com/google/uuid v1.6.0 // indirect\n    \tgithub.com/pkoukk/tiktoken-go
    v0.1.6 // indirect\n    )\n  </file>\n  <file path=\"tools/.experimental/evolve/go.sum\">\n
